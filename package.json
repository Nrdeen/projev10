{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "NODE_ENV=production tsx server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc -p tsconfig.json --noEmit && tsc -p src/tsconfig.json --noEmit",
    "test": "tsx --test tests/unit/*.test.ts tests/integration/*.test.ts",
    "test:unit": "tsx --test tests/unit/*.test.ts",
    "test:e2e": "tsx --test tests/e2e/*.e2e.ts",
    "user:create-admin": "tsx scripts/manage-users.ts create-admin",
    "user:set-password": "tsx scripts/manage-users.ts set-password",
    "db:migrate:json-to-pg": "tsx scripts/migrate-json-to-pg.ts",
    "db:seed-catalog": "tsx scripts/seed-reference-catalog.ts",
    "db:verify-pg": "tsx scripts/verify-pg-migration.ts",
    "media:migrate": "tsx scripts/migrate-media-to-object.ts",
    "media:verify": "tsx scripts/migrate-media-to-object.ts --verify-only",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p src/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.1",
    "argon2": "^0.41.1",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.23.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "vite": "^8.3.0",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "@types/express": "^4.17.21"
  }
}
